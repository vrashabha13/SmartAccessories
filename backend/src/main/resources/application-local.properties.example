# Local-only configuration example.
# Copy this file to application-local.properties and fill in your real values.

spring.datasource.url=jdbc:mysql://localhost:3306/mobile_accessories
spring.datasource.username=root
spring.datasource.password=replace-with-your-local-db-password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

jwt.secret=replace-with-a-long-random-secret
jwt.expiration-ms=86400000

razorpay.key-id=replace-with-your-razorpay-key-id
razorpay.key-secret=replace-with-your-razorpay-secret
